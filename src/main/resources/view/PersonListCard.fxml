<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- The index sits in its own column, so the name, tags and details all line up beside it -->
<HBox id="cardPane" fx:id="cardPane" spacing="12" xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1">
    <padding>
        <Insets top="8" right="16" bottom="8" left="16"/>
    </padding>
    <!-- A fixed width keeps names lined up when the index goes from 9 to 10 -->
    <Label fx:id="id" styleClass="cell_index_label" minWidth="28"/>
    <VBox spacing="4" HBox.hgrow="ALWAYS">
        <HBox alignment="CENTER_LEFT">
            <Label fx:id="name" text="\$first" styleClass="cell_big_label"/>
            <!-- An empty region that grows to fill the gap, pushing the phone number to the right -->
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="phone" styleClass="cell_phone_label" text="\$phone">
                <minWidth>
                    <!-- Ensures that the phone number is never truncated, even when the name is long -->
                    <Region fx:constant="USE_PREF_SIZE"/>
                </minWidth>
            </Label>
        </HBox>
        <FlowPane fx:id="tags"/>
        <Label fx:id="email" styleClass="cell_small_label" wrapText="true" text="\$email"/>
        <Label fx:id="address" styleClass="cell_small_label" wrapText="true" text="\$address"/>
        <HBox fx:id="billing" spacing="16">
            <Label fx:id="fee" styleClass="cell_small_label" text="\$fee"/>
            <Label fx:id="dueDate" styleClass="cell_small_label" text="\$dueDate"/>
        </HBox>
        <Label fx:id="note" styleClass="cell_small_label" wrapText="true" text="\$note"/>
    </VBox>
</HBox>
