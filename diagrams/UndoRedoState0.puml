@startuml
!include style.puml
skinparam ClassFontColor #000000
skinparam ClassBorderColor #000000
skinparam ClassBackgroundColor #FFFFAA

title Initial state

package "history" <<rectangle>> {
    class H1 as "(empty)" #FFFFFF
    class H2 as "<u>abX:AddressBook</u>"
}

H1 -[hidden]right-> H2
hide H2

package "current" <<rectangle>> {
    class Current as "<u>ab0:AddressBook</u>"
}

H2 -[hidden]right-> Current

class Top as "Top of history" #FFFFFF
Top -up-> H1
hide Top
@enduml
