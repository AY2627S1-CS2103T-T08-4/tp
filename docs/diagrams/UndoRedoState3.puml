@startuml
!include style.puml
skinparam ClassFontColor #000000
skinparam ClassBorderColor #000000
skinparam ClassBackgroundColor #FFFFAA

title After command "undo"

package "undoHistory" <<rectangle>> {
    class U1 as "<u>ab0:AddressBook</u>"
}

package "current" <<rectangle>> {
    class Current as "<u>ab1:AddressBook</u>"
}

package "redoHistory" <<rectangle>> {
    class R1 as "<u>ab2:AddressBook</u>"
}

U1 -[hidden]right-> Current
Current -[hidden]right-> R1

class UndoTop as "Top of undoHistory" #FFFFFF
UndoTop -up-> U1

class RedoTop as "Top of redoHistory" #FFFFFF
RedoTop -up-> R1
@enduml
