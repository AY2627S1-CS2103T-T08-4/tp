@startuml
!include style.puml
skinparam ArrowFontStyle plain

box Logic LOGIC_COLOR_T1
participant ":LogicManager" as LogicManager LOGIC_COLOR
participant ":AddressBookParser" as AddressBookParser LOGIC_COLOR
participant ":FilterCommandParser" as FilterCommandParser LOGIC_COLOR
participant "<<class>>\nArgumentTokenizer" as ArgumentTokenizer LOGIC_COLOR
participant "<<class>>\nParserUtil" as ParserUtil LOGIC_COLOR
participant "f:FilterCommand" as FilterCommand LOGIC_COLOR
participant "p:PersonMatchesSearchPredicate" as Predicate LOGIC_COLOR
end box

box Model MODEL_COLOR_T1
participant "m:Model" as Model MODEL_COLOR
end box

[-> LogicManager : execute("filter p/92345678 t/Sec4")
activate LogicManager

LogicManager -> AddressBookParser : parseCommand("filter p/92345678 t/Sec4")
activate AddressBookParser

create FilterCommandParser
AddressBookParser -> FilterCommandParser
activate FilterCommandParser
FilterCommandParser --> AddressBookParser
deactivate FilterCommandParser

AddressBookParser -> FilterCommandParser : parse("p/92345678 t/Sec4")
activate FilterCommandParser
FilterCommandParser -> ArgumentTokenizer : tokenize(args, PREFIX_PHONE, PREFIX_TAG,\nother add/edit prefixes)
activate ArgumentTokenizer
ArgumentTokenizer --> FilterCommandParser : tokenized arguments
deactivate ArgumentTokenizer

FilterCommandParser -> ParserUtil : parsePhone(phoneValue)
activate ParserUtil
ParserUtil --> FilterCommandParser : Phone
deactivate ParserUtil
FilterCommandParser -> ParserUtil : parseTag(tagValue)
activate ParserUtil
ParserUtil --> FilterCommandParser : Tag
deactivate ParserUtil

create Predicate
FilterCommandParser -> Predicate : create(phones, tags)
activate Predicate
Predicate --> FilterCommandParser
deactivate Predicate

create FilterCommand
FilterCommandParser -> FilterCommand : create(predicate)
activate FilterCommand
FilterCommand --> FilterCommandParser
deactivate FilterCommand
FilterCommandParser --> AddressBookParser : f
deactivate FilterCommandParser
AddressBookParser --> LogicManager : f
deactivate AddressBookParser

LogicManager -> FilterCommand : execute(m)
activate FilterCommand
FilterCommand -> Model : updateFilteredPersonList(predicate)
activate Model
Model --> FilterCommand
deactivate Model
FilterCommand -> Model : getFilteredPersonList()
activate Model
Model --> FilterCommand : matching clients
deactivate Model

FilterCommand --> LogicManager : result
deactivate FilterCommand

[<--LogicManager
deactivate LogicManager
@enduml
