@startuml
!include style.puml
skinparam ClassFontColor #000000
skinparam ClassBorderColor #000000
skinparam ClassBackgroundColor #FFFFAA

title Initial state

package "undoHistory" <<rectangle>> {
    class U0 as "(empty)" #FFFFFF
}

package "current" <<rectangle>> {
    class Current as "<u>ab0:AddressBook</u>"
}

package "redoHistory" <<rectangle>> {
    class R0 as "(empty)" #FFFFFF
}

U0 -[hidden]right-> Current
Current -[hidden]right-> R0
@enduml
