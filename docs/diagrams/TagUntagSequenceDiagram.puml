@startuml
!include style.puml
skinparam ArrowFontStyle plain

box Logic LOGIC_COLOR_T1
participant ":LogicManager" as LogicManager LOGIC_COLOR
participant ":AddressBookParser" as AddressBookParser LOGIC_COLOR
participant ":TagCommandParser /\n:UntagCommandParser" as CommandParser LOGIC_COLOR
participant "<<class>>\nArgumentTokenizer" as ArgumentTokenizer LOGIC_COLOR
participant "<<class>>\nParserUtil" as ParserUtil LOGIC_COLOR
participant "c:TagCommand /\nc:UntagCommand" as Command LOGIC_COLOR
end box

box Model MODEL_COLOR_T1
participant "m:Model" as Model MODEL_COLOR
end box

[-> LogicManager : execute("tag 1 t/Physics" /\n"untag 1 t/Physics")
activate LogicManager

LogicManager -> AddressBookParser : parseCommand(userInput)
activate AddressBookParser

create CommandParser
AddressBookParser -> CommandParser : create the corresponding parser
activate CommandParser
CommandParser --> AddressBookParser
deactivate CommandParser

AddressBookParser -> CommandParser : parse(arguments)
activate CommandParser
CommandParser -> ArgumentTokenizer : tokenize(arguments, PREFIX_TAG)
activate ArgumentTokenizer
ArgumentTokenizer --> CommandParser : tokenized arguments
deactivate ArgumentTokenizer

group validate and parse index and tags
    CommandParser -> ParserUtil : parseIndex(preamble)
    activate ParserUtil
    ParserUtil --> CommandParser : index
    deactivate ParserUtil
    CommandParser -> ParserUtil : parseTag(tagValue)
    activate ParserUtil
    ParserUtil --> CommandParser : Tag
    deactivate ParserUtil
end

create Command
CommandParser -> Command : create(index, tags)
activate Command
Command --> CommandParser
deactivate Command
CommandParser --> AddressBookParser : c
deactivate CommandParser
AddressBookParser --> LogicManager : c
deactivate AddressBookParser

LogicManager -> Command : execute(m)
activate Command
Command -> Model : getFilteredPersonList()
activate Model
Model --> Command : displayed clients
deactivate Model

alt tag: at least one requested tag is new
    Command -> Command : create person with new tags
    Command -> Model : setPerson(original, taggedPerson)
    activate Model
    Model --> Command
    deactivate Model
else untag: at least one requested tag exists
    Command -> Command : create person without existing requested tags
    Command -> Model : setPerson(original, untaggedPerson)
    activate Model
    Model --> Command
    deactivate Model
else no tags need changing
    note right of Command: Leave the model unchanged
end

opt tags changed
    Command -> Model : updateFilteredPersonList(previouslyDisplayed)
    activate Model
    Model --> Command
    deactivate Model
end

Command --> LogicManager : result
deactivate Command

[<--LogicManager
deactivate LogicManager
@enduml
